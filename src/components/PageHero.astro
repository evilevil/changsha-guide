---
import { rich } from '../lib/rich';

interface Props {
  title: string;
  sub?: string;
  badge?: string;
  /** h1（内页）或 h2（首页区块） */
  as?: 'h1' | 'h2';
}

const { title, sub, badge, as = 'h1' } = Astro.props;
const Tag = as;
---

<header class="wrap pb-2 pt-10 text-center md:pt-14">
  {badge && <div class="hero-badge mb-4">{badge}</div>}
  <Tag class="text-3xl font-bold leading-tight md:text-4xl">{title}</Tag>
  {sub && <p class="mx-auto mt-3 max-w-2xl text-sm md:text-base" style="color: var(--ink-2);" set:html={rich(sub)} />}
</header>
