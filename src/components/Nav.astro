---
import { nav, url } from '../data/site';

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const target = url(href).replace(/\/+$/, '') || '/';
  return target === current;
};
---

<nav
  class="no-print fixed inset-x-0 top-0 z-50 border-b"
  style="background: var(--glass); border-color: var(--glass-border); backdrop-filter: blur(20px);"
>
  <div class="wrap flex h-16 items-center justify-between gap-3">
    <a href={url('/')} class="flex shrink-0 items-center gap-2 text-lg font-bold" style="color: var(--brand);">
      <span aria-hidden="true">🍊</span>
      长沙星城游
    </a>

    <ul class="hidden items-center gap-0.5 lg:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={url(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="rounded-lg px-3 py-2 text-sm font-medium transition-colors duration-200"
              style={
                isActive(item.href)
                  ? 'color: var(--brand); background: var(--bg-3);'
                  : 'color: var(--ink-2);'
              }
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1.5">
      <button
        data-theme-toggle
        class="rounded-lg px-2.5 py-2 text-lg transition-colors hover:opacity-80"
        style="color: var(--ink-2);"
        aria-label="切换深色/浅色主题"
        title="切换主题"
      >
        <span data-theme-icon>🌙</span>
      </button>
      <button
        data-menu-toggle
        class="rounded-lg px-2.5 py-2 text-xl lg:hidden"
        style="color: var(--ink-1);"
        aria-label="打开菜单"
        aria-expanded="false"
      >
        ☰
      </button>
    </div>
  </div>

  <div data-menu class="hidden border-t lg:hidden" style="border-color: var(--glass-border);">
    <ul class="wrap grid grid-cols-2 gap-1 py-3 sm:grid-cols-3">
      {
        nav.map((item) => (
          <li>
            <a
              href={url(item.href)}
              class="flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm font-medium"
              style={
                isActive(item.href)
                  ? 'color: var(--brand); background: var(--bg-3);'
                  : 'color: var(--ink-2);'
              }
            >
              <span aria-hidden="true">{item.icon}</span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
